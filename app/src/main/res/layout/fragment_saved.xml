<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background"
    android:padding="12dp">

    <!-- Selected Scorecard Display -->
    <LinearLayout
        android:id="@+id/selectedCardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/rounded_textbox"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/selectedName"
            android:text="No Scorecard Selected"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/selectedDetails"
            android:text="Species | Type | Score | Date"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- Optional Image -->
        <ImageView
            android:id="@+id/selectedImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:scaleType="centerInside"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/viewBtn"
                android:text="View"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/editBtn"
                android:text="Edit"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/deleteBtn"
                android:text="Delete"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:textColor="@color/black"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Search + Filters + Sort -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/searchBox"
            android:hint="Search"
            android:textColor="@color/black"
            android:textColorHint="@color/black"
            android:background="@drawable/rounded_textbox"
            android:padding="8dp"
            android:layout_weight="2"
            android:layout_width="0dp"
            android:layout_height="40dp"/>

        <Spinner
            android:id="@+id/speciesFilter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/rounded_dropbox"/>

        <Spinner
            android:id="@+id/sort"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/rounded_dropbox"/>
    </LinearLayout>

    <!-- Scorecard List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scorecardRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
